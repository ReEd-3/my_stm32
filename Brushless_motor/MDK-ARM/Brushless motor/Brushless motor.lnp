--cpu Cortex-M3
"brushless motor\startup_stm32f103xb.o"
"brushless motor\main.o"
"brushless motor\gpio.o"
"brushless motor\dma.o"
"brushless motor\tim.o"
"brushless motor\stm32f1xx_it.o"
"brushless motor\stm32f1xx_hal_msp.o"
"brushless motor\dshot_driver.o"
"brushless motor\stm32f1xx_hal_gpio_ex.o"
"brushless motor\stm32f1xx_hal_tim.o"
"brushless motor\stm32f1xx_hal_tim_ex.o"
"brushless motor\stm32f1xx_hal.o"
"brushless motor\stm32f1xx_hal_rcc.o"
"brushless motor\stm32f1xx_hal_rcc_ex.o"
"brushless motor\stm32f1xx_hal_gpio.o"
"brushless motor\stm32f1xx_hal_dma.o"
"brushless motor\stm32f1xx_hal_cortex.o"
"brushless motor\stm32f1xx_hal_pwr.o"
"brushless motor\stm32f1xx_hal_flash.o"
"brushless motor\stm32f1xx_hal_flash_ex.o"
"brushless motor\stm32f1xx_hal_exti.o"
"brushless motor\system_stm32f1xx.o"
--strict --scatter "Brushless motor\Brushless motor.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Brushless motor.map" -o "Brushless motor\Brushless motor.axf"